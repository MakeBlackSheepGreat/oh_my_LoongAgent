# 模型供应商 API 密钥（运行时必需，否则任务草案无法执行）
# 启动前设置环境变量，或复制此文件为 .env 并填入密钥
HARNESS_DEEPSEEK_API_KEY=sk-你的DeepSeek密钥

# 可选：其他预设供应商
# HARNESS_SILICONFLOW_API_KEY=sk-你的硅基流动密钥
# HARNESS_MODELSCOPE_API_KEY=sk-你的ModelScope密钥
# HARNESS_LOCAL_API_KEY=sk-你的本地模型密钥

# 可选：覆盖默认 Provider 配置（JSON 格式）
# HARNESS_PROVIDER_CONFIG={"provider_id":"siliconflow","base_url":"https://api.siliconflow.cn/v1","model_id":"deepseek-ai/DeepSeek-V3","api_key_env":"HARNESS_SILICONFLOW_API_KEY"}